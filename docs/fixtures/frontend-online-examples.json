    "Abort stale query: ignore late response even if cancellation races.",
    "Malformed JSON/envelope: invalid-response; never silently use mock data.",
    "Change dataset/filter/sort: clear cursor and incompatible selection.",
    "Review conflict GET failure: retain draft, do not auto-PATCH new version."
  ]
}
