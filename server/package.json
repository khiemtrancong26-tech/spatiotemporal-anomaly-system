{
  "name": "@pm25/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=../.env dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:coverage": "vitest run --coverage",
    "test:e2e:b2": "playwright test --config playwright.config.ts auth-session.spec.ts",
    "db:indexes": "tsx --env-file-if-exists=../.env scripts/ensure-indexes.ts",
    "db:seed": "tsx --env-file-if-exists=../.env scripts/seed-demo.ts",
    "db:exploration": "tsx --env-file-if-exists=../.env scripts/configure-exploration.ts",
    "test:e2e:c2": "playwright test --config playwright.config.ts dataset-exploration.spec.ts",
    "test:e2e:c3": "playwright test --config playwright.config.ts isolation-forest.spec.ts",
    "ml:export-v2": "tsx scripts/export-pm25-v2-features.ts",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "test:e2e:b3": "playwright test --config playwright.config.ts dataset-import.spec.ts",
    "test:e2e:b4": "playwright test --config playwright.config.ts workspace-query.spec.ts",
    "test:e2e:b5": "playwright test --config playwright.config.ts statistical-analysis.spec.ts",
    "test:e2e:b6": "playwright test --config playwright.config.ts anomaly-review.spec.ts",
    "benchmark:analysis": "node --expose-gc --import tsx scripts/benchmark-analysis.ts",
    "prebenchmark:analysis": "npm run build --workspace @pm25/server",
    "benchmark:query": "node --expose-gc --import tsx scripts/benchmark-query.ts",
    "benchmark:exploration": "node --import tsx scripts/benchmark-exploration.ts",
    "pretypecheck": "npm run build --workspace @pm25/shared-core",
    "prebuild": "npm run build --workspace @pm25/shared-core",
    "pretest": "npm run build --workspace @pm25/shared-core",
    "pretest:integration": "npm run build --workspace @pm25/shared-core",
    "pretest:coverage": "npm run build --workspace @pm25/shared-core",
    "verify:detectors": "tsx scripts/verify-detector-integration.ts",
    "preverify:detectors": "npm run build --workspace @pm25/shared-core",
    "test:e2e:b7": "playwright test --config playwright.config.ts admin-users.spec.ts",
    "test:e2e:ownership": "playwright test --config playwright.config.ts dataset-ownership.spec.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "@types/nodemailer": "8.0.2",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "mongodb-memory-server": "11.3.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0",
    "yaml": "2.9.1"
  },
  "dependencies": {
    "@fastify/ajv-compiler": "4.0.7",
    "@fastify/cors": "11.4.3",
    "@fastify/multipart": "10.1.8",
    "@fastify/rate-limit": "11.2.2",
    "@pm25/shared-core": "0.1.0",
    "csv-parse": "7.0.3",
    "fastify": "5.12.8",
    "fastify-plugin": "6.0.1",
    "jose": "6.2.17",
    "mongodb": "7.9.0",
    "nodemailer": "10.6.0",
    "zod": "4.6.7"
  }
}
