{
  "name": "@pm25/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=../.env dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --exclude tests/*.integration.test.ts",
    "test:integration": "vitest run .integration.test.ts",
    "test:coverage": "vitest run --coverage",
    "test:e2e:b2": "playwright test --config playwright.config.ts",
    "db:indexes": "tsx --env-file-if-exists=../.env scripts/ensure-indexes.ts",
    "db:seed": "tsx --env-file-if-exists=../.env scripts/seed-demo.ts",
    "check": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "mongodb-memory-server": "11.3.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0",
    "yaml": "2.9.1"
  },
  "dependencies": {
    "@fastify/ajv-compiler": "4.0.7",
    "@fastify/cors": "11.4.3",
    "@fastify/rate-limit": "11.2.2",
    "fastify": "5.12.8",
    "fastify-plugin": "6.0.1",
    "jose": "6.2.17",
    "mongodb": "7.9.0"
  }
}
