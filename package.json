{
  "name": "spatiotemporal-anomaly-system",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run dev --workspace @pm25/client",
    "dev:mock": "npm run dev:mock --workspace @pm25/client",
    "dev:server": "npm run dev --workspace @pm25/server",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:server:integration": "npm run test:integration --workspace @pm25/server",
    "test:e2e:b2": "npm run test:e2e:b2 --workspace @pm25/server",
    "test:e2e": "npm run test:e2e --workspace @pm25/client",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "test:e2e:b3": "npm run test:e2e:b3 --workspace @pm25/server",
    "test:e2e:b4": "npm run test:e2e:b4 --workspace @pm25/server"
  },
  "workspaces": [
    "client",
    "server",
    "shared-core"
  ]
}
