# Backend
PORT=3001
HOST=127.0.0.1
MONGODB_URI=mongodb://127.0.0.1:27017/spatiotemporal_anomaly
# Optional DB-name override; otherwise use the database from MONGODB_URI.
# MONGODB_DATABASE=spatiotemporal_anomaly
MONGODB_TIMEOUT_MS=2000
LOG_LEVEL=info
# Explicit development browser origins. Leave empty for same-origin deployments.
CORS_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:4173
# Required: generate once using node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Keep this secret stable across restarts; no default value is provided.
JWT_SECRET=
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MS=60000

# Optional explicit demo bootstrap; passwords must be supplied to run db:seed.
# SEED_ADMIN_USERNAME=admin01
# SEED_ADMIN_PASSWORD=
# SEED_ANALYST_USERNAME=analyst01
# SEED_ANALYST_PASSWORD=
# SEED_DEMO_DATA=true

# Frontend
VITE_API_BASE_URL=http://localhost:3001/api/v1
VITE_MAPBOX_TOKEN=your_mapbox_public_token

# Optional - Redis
# REDIS_URL=redis://localhost:6379
